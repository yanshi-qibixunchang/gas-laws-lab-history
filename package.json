{
  "name": "hard-sphere-lab",
  "version": "6.4.3",
  "description": "Windows engineering workbench for hard-sphere molecular dynamics, ideal-gas relation studies, and air heat-capacity-ratio experiments.",
  "author": {
    "name": "Project Team",
    "url": "https://github.com/yanshi-qibixunchang/gas-laws-lab-history"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yanshi-qibixunchang/gas-laws-lab-history.git"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:temp": "vite --host 127.0.0.1 --port 5184 --strictPort",
    "icons:generate": "electron scripts/generateAppIcons.cjs",
    "icons:check": "node scripts/verifyAppIconResources.cjs",
    "legal:generate": "node scripts/generateLegalNotices.cjs",
    "legal:check": "node scripts/generateLegalNotices.cjs --check",
    "release:verify-assets": "node scripts/verifyReleaseAssets.cjs",
    "build": "node scripts/verifyAppIconResources.cjs && node scripts/generateLegalNotices.cjs && vite build && node scripts/checkBuildOutput.cjs",
    "desktop:dev": "npm run build && electron .",
    "desktop:build": "npm run build",
    "desktop:installer": "npm run exporter:bundle && npm run exporter:check && npm run build && set CSC_IDENTITY_AUTO_DISCOVERY=false&& node scripts/runElectronBuilder.cjs nsis && node scripts/writeReleaseMetadata.cjs && npm run release:verify-assets",
    "desktop:portable": "npm run exporter:bundle && npm run exporter:check && npm run build && set CSC_IDENTITY_AUTO_DISCOVERY=false&& node scripts/runElectronBuilder.cjs portable",
    "exporter:bundle": "node scripts/bundleExporter.cjs",
    "exporter:check": "node scripts/checkBundledExporter.cjs",
    "test": "node scripts/runTests.cjs",
    "check": "tsc --noEmit --noUnusedLocals --noUnusedParameters && npm test",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.hardspherelab.desktop",
    "productName": "Gas Laws Lab",
    "electronDist": "node_modules/electron/dist",
    "afterPack": "build/afterPack.cjs",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "yanshi-qibixunchang",
        "repo": "gas-laws-lab-release"
      }
    ],
    "electronUpdaterCompatibility": ">=2.16",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "docs/releases/release-notes.json",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/app-icon",
        "to": "app-icon",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "public/legal",
        "to": "legal",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/exporter",
        "to": "exporter",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "tools/exporter/hsl_exporter.py",
        "to": "exporter/hsl_exporter.py"
      },
      {
        "from": "tools/exporter/professional_graph_style.py",
        "to": "exporter/professional_graph_style.py"
      }
    ],
    "win": {
      "icon": "resources/app-icon/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "heat-capacity-lab-setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "displayLanguageSelector": false,
      "language": "2052",
      "include": "build/installer.nsh",
      "installerIcon": "resources/app-icon/icon.ico",
      "uninstallerIcon": "resources/app-icon/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Gas Laws Lab"
    }
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.17.10",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.292.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "0.182.0",
    "three-stdlib": "^2.36.1"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@types/three": "0.182.0",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.18",
    "electron": "^41.10.7",
    "electron-builder": "^26.15.3",
    "electron-winstaller": "^5.4.4",
    "js-yaml": "^4.3.2",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.2.2",
    "vite": "^8.1.4"
  }
}
